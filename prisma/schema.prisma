generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" 
}

// --- ENUMS ---
enum Role {
  USER
  ADMIN
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RelationType {
  // Familiares
  PARENT
  CHILD
  SPOUSE
  SIBLING

  // Sociais e Pessoais
  FRIEND
  ACQUAINTANCE
  ROMANTIC

  // Profissionais e Acadêmicos
  COLLEAGUE
  TEAMMATE
  MENTOR
  STUDENT
  PARTNER
  
  // Genéricos
  OTHER
}

// --- MODELS ---

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  password  String
  image     String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())

  // Relacionamentos (1 para N)
  personTrees       PersonTree[]
  requestsMade      NodeRequest[] @relation("UserRequests")
  requestsReviewed  NodeRequest[] @relation("AdminReviews")
  globalNodes       GlobalNode[]  @relation("UserCreatedNodes")
  globalEdges       GlobalEdge[]  @relation("UserCreatedEdges")

  @@map("USER")
}

model PersonTree {
  id        String   @id @default(uuid())
  userId    String
  name      String
  createdAt DateTime @default(now())

  // Relacionamentos
  user           User                  @relation(fields: [userId], references: [id])
  nodes          PersonNode[]
  edges          PersonEdge[]
  relationLabels PersonRelationLabel[]

  @@map("PERSON_TREE")
}

model PersonRelationLabel {
  id        String   @id @default(uuid())
  treeId    String
  name      String
  createdAt DateTime @default(now())

  // Relacionamentos
  tree  PersonTree   @relation(fields: [treeId], references: [id])
  edges PersonEdge[]

  @@unique([treeId, name])
  @@map("PERSON_RELATION_LABEL")
}

model PersonNode {
  id        String    @id @default(uuid())
  treeId    String
  name      String
  birthDate DateTime? @db.Date
  deathDate DateTime? @db.Date
  gender    String?
  bio       String?   @db.Text
  photoUrl  String?

  // Relacionamentos
  tree      PersonTree   @relation(fields: [treeId], references: [id])
  edgesFrom PersonEdge[] @relation("EdgeFrom")
  edgesTo   PersonEdge[] @relation("EdgeTo")

  @@map("PERSON_NODE")
}

model PersonEdge {
  id              String        @id @default(uuid())
  treeId          String
  fromId          String
  toId            String
  relation        RelationType?
  relationLabelId String?

  // Relacionamentos
  tree          PersonTree           @relation(fields: [treeId], references: [id])
  fromNode      PersonNode           @relation("EdgeFrom", fields: [fromId], references: [id])
  toNode        PersonNode           @relation("EdgeTo", fields: [toId], references: [id])
  relationLabel PersonRelationLabel? @relation(fields: [relationLabelId], references: [id])

  @@map("PERSON_EDGE")
}

model NodeRequest {
  id            String        @id @default(uuid())
  userId        String
  status        RequestStatus @default(PENDING)
  nodeName      String
  nodeBirthDate DateTime?     @db.Date
  nodeDeathDate DateTime?     @db.Date
  nodeGender    String?
  nodeBio       String?       @db.Text
  nodePhotoUrl  String?
  nodeTagSlug   String        @default("person")
  userNote      String?       @db.Text
  adminNote     String?       @db.Text
  reviewedById  String?
  reviewedAt    DateTime?

  // Relacionamentos
  requester    User              @relation("UserRequests", fields: [userId], references: [id])
  reviewer     User?             @relation("AdminReviews", fields: [reviewedById], references: [id])
  connections  NodeRequestConn[]

  @@map("NODE_REQUEST")
}

model NodeRequestConn {
  id            String       @id @default(uuid())
  requestId     String
  globalNodeId  String
  relation      String
  newNodeIsFrom Boolean
  description   String?      @db.Text
  documentTitle String?
  documentContent String?    @db.Text
  documentImageUrl String?

  // Relacionamentos
  request       NodeRequest @relation(fields: [requestId], references: [id])
  globalNode    GlobalNode  @relation(fields: [globalNodeId], references: [id])

  @@map("NODE_REQUEST_CONN")
}

model GlobalNode {
  id          String    @id @default(uuid())
  name        String
  birthDate   DateTime? @db.Date
  deathDate   DateTime? @db.Date
  gender      String?
  bio         String?   @db.Text
  photoUrl    String?
  tagSlug     String    @default("person")
  createdById String

  // Relacionamentos
  creator     User              @relation("UserCreatedNodes", fields: [createdById], references: [id])
  connections NodeRequestConn[]
  edgesFrom   GlobalEdge[]      @relation("GlobalEdgeFrom")
  edgesTo     GlobalEdge[]      @relation("GlobalEdgeTo")

  @@index([tagSlug])
  @@map("GLOBAL_NODE")
}

model GlobalTag {
  id           String   @id @default(uuid())
  slug         String   @unique
  label        String
  description  String   @db.Text
  background   String
  surface      String
  border       String
  primary      String
  secondary    String
  muted        String
  node         String
  nodeSelected String
  edge         String
  edgeSelected String
  genderLabel    String @default("Genero")
  birthDateLabel String @default("Nascimento")
  deathDateLabel String @default("Falecimento")
  bioLabel       String @default("Biografia")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  relations    GlobalTagRelation[]
  genderOptions GlobalTagGenderOption[]

  @@map("GLOBAL_TAG")
}

model GlobalTagGenderOption {
  id        String   @id @default(uuid())
  tagSlug   String
  key       String
  label     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tag       GlobalTag @relation(fields: [tagSlug], references: [slug], onDelete: Cascade, onUpdate: Cascade)

  @@unique([tagSlug, key])
  @@index([tagSlug])
  @@map("GLOBAL_TAG_GENDER_OPTION")
}

model GlobalTagRelation {
  id        String   @id @default(uuid())
  tagSlug   String
  key       String
  label     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tag       GlobalTag @relation(fields: [tagSlug], references: [slug], onDelete: Cascade, onUpdate: Cascade)

  @@unique([tagSlug, key])
  @@index([tagSlug])
  @@map("GLOBAL_TAG_RELATION")
}

model GlobalEdge {
  id          String       @id @default(uuid())
  fromId      String
  toId        String
  relation    String
  description String?      @db.Text
  documentTitle String?
  documentContent String?  @db.Text
  documentImageUrl String?
  createdById String

  // Relacionamentos
  creator     User       @relation("UserCreatedEdges", fields: [createdById], references: [id])
  fromNode    GlobalNode @relation("GlobalEdgeFrom", fields: [fromId], references: [id])
  toNode      GlobalNode @relation("GlobalEdgeTo", fields: [toId], references: [id])

  @@map("GLOBAL_EDGE")
}
